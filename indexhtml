<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kuis Pancasila Online</title>
  <style>
    /* Mengatur halaman agar kuis berada tepat di tengah screen */
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #f5f0fa; /* Warna latar belakang ungu lembut */
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Kontainer utama untuk membungkus kuis */
    .web-container {
      width: 100%;
      height: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 10px;
      box-sizing: border-box;
    }

    /* Mengatur tampilan Bingkai Kuis Google Script */
    iframe {
      width: 100%;
      max-width: 650px; /* Batas lebar maksimal agar proporsional di PC */
      height: 90vh;    /* Tinggi kuis menyesuaikan layar device (90% dari tinggi layar) */
      border: none;
      border-radius: 16px;
      box-shadow: 0 8px 24px rgba(103, 58, 183, 0.15); /* Efek bayangan estetik */
      background-color: #ffffff;
    }

    /* Responsivitas untuk layar HP yang sangat kecil */
    @media (max-width: 480px) {
      .web-container {
        padding: 0;
      }
      iframe {
        height: 100%;
        border-radius: 0;
      }
    }
  </style>
</head>
<body>

  <div class="web-container">
    <!-- Menyematkan Google Apps Script Anda langsung ke dalam website GitHub -->
    <iframe 
      src="https://script.google.com/macros/s/AKfycbyz4ZxqE6frBxUmlRsnu7XAt4nQYFcaBbjoEnUwssQ6UoaMwGaBT58U-BUJ-Z2Sjpbw/exec" 
      allow="autoplay">
    </iframe>
  </div>

</body>
</html>
